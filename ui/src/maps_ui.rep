// View <-> backend contract for the Maps view.
//
// The backend is a thin, Qt-typed proxy over maps_core: SLOTs forward to the
// core's module API, PROPs mirror its state, and layersChanged fires on every
// core event so the view can refetch. Keep slots to <= 4 arguments; pass
// structured data (layer definitions, GeoJSON) as one JSON string.
class MapsUi
{
    SLOT(bool addLayer(QString layerId, QString layerJson))
    SLOT(bool removeLayer(QString layerId))
    SLOT(bool setFeatures(QString layerId, QString geojson))
    SLOT(QString getLayer(QString layerId))
    SLOT(QString getFeatures(QString layerId))
    SLOT(QString listLayers())

    PROP(int layerCount=0 READONLY)
    PROP(QString status="Ready" READONLY)

    SIGNAL(layersChanged())
}
