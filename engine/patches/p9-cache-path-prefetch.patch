 #pragma warning(push)
@@ -363,16 +365,38 @@ void Settings::setCacheDatabaseMaximumSize(unsigned size) {
 
     By default, it is set to `:memory:` meaning it will create an in-memory
     cache instead of a file on disk.
+
+    When the path was set to an empty string, the returned value is the
+    application's on-disk cache location
+    (\c QStandardPaths::CacheLocation `/QMapLibre/cache.db`); the directory
+    is created on demand.
 */
 QString Settings::cacheDatabasePath() const {
-    return d_ptr->m_cacheDatabasePath;
+    if (!d_ptr->m_cacheDatabasePath.isEmpty()) {
+        return d_ptr->m_cacheDatabasePath;
+    }
+
+    const QString base = QStandardPaths::writableLocation(QStandardPaths::CacheLocation);
+    if (base.isEmpty()) {
+        return QStringLiteral(":memory:");
+    }
+
+    QDir dir(base + QStringLiteral("/QMapLibre"));
+    if (!dir.exists() && !dir.mkpath(QStringLiteral("."))) {
+        qWarning() << "Cannot create cache directory" << dir.path() << "- using an in-memory cache";
+        return QStringLiteral(":memory:");
+    }
+
+    return dir.filePath(QStringLiteral("cache.db"));
 }
 
