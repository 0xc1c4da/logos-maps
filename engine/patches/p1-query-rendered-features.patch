+// Feature query helpers.
+
+std::optional<mbgl::style::Filter> filterFromVariant(const QVariant &filter) {
+    if (!filter.isValid() || filter.isNull() || filter.toList().isEmpty()) {
+        return std::nullopt;
+    }
+
+    mbgl::style::conversion::Error error;
+    std::optional<mbgl::style::Filter> converted = mbgl::style::conversion::convert<mbgl::style::Filter>(filter, error);
+    if (!converted) {
+        qWarning() << "Error parsing filter:" << error.message.c_str();
+    }
+    return converted;
+}
+
+std::optional<std::vector<std::string>> stringsFromList(const QStringList &list) {
+    if (list.isEmpty()) {
+        return std::nullopt;
+    }
+
+    std::vector<std::string> strings;
+    strings.reserve(static_cast<size_t>(list.size()));
+    for (const QString &item : list) {
+        strings.push_back(item.toStdString());
+    }
+    return strings;
+}
+
+using JSONWriter = rapidjson::Writer<rapidjson::StringBuffer>;
+
+void writeValue(JSONWriter &writer, const mbgl::Value &value) {
+    value.match([&](const mbgl::NullValue) { writer.Null(); },
+                [&](const bool value_) { writer.Bool(value_); },
+                [&](const uint64_t value_) { writer.Uint64(value_); },
+                [&](const int64_t value_) { writer.Int64(value_); },
+                [&](const double value_) { writer.Double(value_); },
+                [&](const std::string &value_) { writer.String(value_.c_str(), static_cast<unsigned>(value_.size())); },
+                [&](const std::vector<mbgl::Value> &vector) {
+                    writer.StartArray();
+                    for (const auto &item : vector) {
+                        writeValue(writer, item);
+                    }
+                    writer.EndArray();
+                },
+                [&](const std::unordered_map<std::string, mbgl::Value> &map) {
+                    writer.StartObject();
+                    for (const auto &item : map) {
+                        writer.Key(item.first.c_str(), static_cast<unsigned>(item.first.size()));
+                        writeValue(writer, item.second);
+                    }
+                    writer.EndObject();
+                });
+}
+
+void writeFeature(JSONWriter &writer, const mbgl::Feature &feature) {
+    writer.StartObject();
+    writer.Key("type");
+    writer.String("Feature");
+
+    if (!feature.id.is<mbgl::NullValue>()) {
+        writer.Key("id");
+        feature.id.match([&](const mbgl::NullValue) { writer.Null(); },
+                         [&](const uint64_t id) { writer.Uint64(id); },
+                         [&](const int64_t id) { writer.Int64(id); },
+                         [&](const double id) { writer.Double(id); },
+                         [&](const std::string &id) { writer.String(id.c_str(), static_cast<unsigned>(id.size())); });
+    }
+
+    writer.Key("geometry");
+    mapbox::geojson::rapidjson_allocator allocator;
+    mapbox::geojson::convert<mapbox::geojson::geometry>(feature.geometry, allocator).Accept(writer);
+
+    writer.Key("properties");
+    writeValue(writer, mbgl::Value(feature.properties));
+
+    writer.Key("source");
+    writer.String(feature.source.c_str(), static_cast<unsigned>(feature.source.size()));
+    writer.Key("sourceLayer");
+    writer.String(feature.sourceLayer.c_str(), static_cast<unsigned>(feature.sourceLayer.size()));
+    writer.Key("state");
+    writeValue(writer, mbgl::Value(feature.state));
+
+    writer.EndObject();
+}
+
+QByteArray featureCollectionJson(const std::vector<mbgl::Feature> &features) {
+    rapidjson::StringBuffer buffer;
+    JSONWriter writer(buffer);
+
+    writer.StartObject();
+    writer.Key("type");
+    writer.String("FeatureCollection");
+    writer.Key("features");
+    writer.StartArray();
+    for (const auto &feature : features) {
+        writeFeature(writer, feature);
+    }
+    writer.EndArray();
+    writer.EndObject();
+
+    return QByteArray(buffer.GetString(), static_cast<qsizetype>(buffer.GetSize()));
+}
