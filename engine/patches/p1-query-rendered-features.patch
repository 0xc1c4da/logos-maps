+/*!
+    \brief Query the features rendered inside a screen box.
+    \param box The box in logical pixels, in the same space as pixelForCoordinate().
+    \param layerIds Restrict the query to these style layers; empty means all layers.
+    \param filter An optional filter expression in the
+    <a href="https://maplibre.org/maplibre-style-spec/expressions/">MapLibre Style Spec</a> format.
+    \return A GeoJSON \c FeatureCollection encoded as UTF-8.
+
+    Each feature additionally carries the \c source and \c sourceLayer it was
+    rendered from and its current feature \c state. Answers from the last
+    rendered frame; returns an empty collection until a renderer exists.
+
+    Safe to call from the GUI thread while rendering happens on another thread.
+*/
+QByteArray Map::queryRenderedFeatures(const QRectF &box, const QStringList &layerIds, const QVariant &filter) const {
+    const mbgl::ScreenBox screenBox{{box.left(), box.top()}, {box.right(), box.bottom()}};
+    return featureCollectionJson(d_ptr->queryRenderedFeatures(
+        screenBox, mbgl::RenderedQueryOptions(stringsFromList(layerIds), filterFromVariant(filter))));
+}
+
+/*!
+    \brief Query the features rendered at a screen point.
+    \param point The point in logical pixels.
+    \param layerIds Restrict the query to these style layers; empty means all layers.
+    \param filter An optional filter expression.
+    \return A GeoJSON \c FeatureCollection encoded as UTF-8.
+
+    \sa queryRenderedFeatures(const QRectF &, const QStringList &, const QVariant &) const
+*/
+QByteArray Map::queryRenderedFeatures(const QPointF &point, const QStringList &layerIds, const QVariant &filter) const {
+    const mbgl::ScreenCoordinate screenPoint{point.x(), point.y()};
+    return featureCollectionJson(d_ptr->queryRenderedFeatures(
+        screenPoint, mbgl::RenderedQueryOptions(stringsFromList(layerIds), filterFromVariant(filter))));
+}
+
+/*!
+    \brief Query the features of a source that are currently loaded.
+    \param sourceId The source identifier.
+    \param sourceLayers For vector sources, the source layers to query; ignored for GeoJSON sources.
+    \param filter An optional filter expression.
+    \return A GeoJSON \c FeatureCollection encoded as UTF-8.
+
+    Only features in tiles that are loaded for the current viewport are returned.
+*/
+QByteArray Map::querySourceFeatures(const QString &sourceId,
+                                    const QStringList &sourceLayers,
+                                    const QVariant &filter) const {
+    return featureCollectionJson(d_ptr->querySourceFeatures(
+        sourceId.toStdString(), mbgl::SourceQueryOptions(stringsFromList(sourceLayers), filterFromVariant(filter))));
+}
