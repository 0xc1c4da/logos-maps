+std::vector<mbgl::Feature> MapPrivate::queryRenderedFeatures(const mbgl::ScreenBox &box,
+                                                             const mbgl::RenderedQueryOptions &options) const {
+    const std::scoped_lock lock(m_mapRendererMutex);
+    return m_mapRenderer ? m_mapRenderer->queryRenderedFeatures(box, options) : std::vector<mbgl::Feature>{};
+}
+
+std::vector<mbgl::Feature> MapPrivate::queryRenderedFeatures(const mbgl::ScreenCoordinate &point,
+                                                             const mbgl::RenderedQueryOptions &options) const {
+    const std::scoped_lock lock(m_mapRendererMutex);
+    return m_mapRenderer ? m_mapRenderer->queryRenderedFeatures(point, options) : std::vector<mbgl::Feature>{};
+}
+
+std::vector<mbgl::Feature> MapPrivate::querySourceFeatures(const std::string &sourceId,
+                                                           const mbgl::SourceQueryOptions &options) const {
+    const std::scoped_lock lock(m_mapRendererMutex);
+    return m_mapRenderer ? m_mapRenderer->querySourceFeatures(sourceId, options) : std::vector<mbgl::Feature>{};
+}
