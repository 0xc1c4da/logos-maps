+/*!
+    \brief Set the state of a feature.
+    \param sourceId The source identifier.
+    \param sourceLayer The source layer, required for vector sources; empty for GeoJSON sources.
+    \param featureId The feature identifier, as a string.
+    \param state Key/value pairs merged into the feature's state.
+
+    Feature state is read by style expressions through \c ["feature-state", key]
+    and is the cheap way to express hover and selection without touching the
+    source data. Returns \c false when no renderer exists yet.
+
+    Safe to call from the GUI thread while rendering happens on another thread.
+*/
+bool Map::setFeatureState(const QString &sourceId,
+                          const QString &sourceLayer,
+                          const QString &featureId,
+                          const QVariantMap &state) {
+    mbgl::FeatureState featureState;
+    for (auto it = state.constBegin(); it != state.constEnd(); ++it) {
+        featureState.emplace(it.key().toStdString(), GeoJSON::asPropertyValue(it.value()));
+    }
+
+    const std::optional<std::string> layer = sourceLayer.isEmpty() ? std::nullopt
+                                                                   : std::optional(sourceLayer.toStdString());
+    d_ptr->setFeatureState(sourceId.toStdString(), layer, featureId.toStdString(), featureState);
+    return d_ptr->hasRenderer();
+}
+
+/*!
+    \brief Get the state of a feature.
+    \param sourceId The source identifier.
+    \param sourceLayer The source layer, empty for GeoJSON sources.
+    \param featureId The feature identifier, as a string.
+    \return The feature's state, empty when unknown.
+*/
+QVariantMap Map::getFeatureState(const QString &sourceId, const QString &sourceLayer, const QString &featureId) const {
+    const std::optional<std::string> layer = sourceLayer.isEmpty() ? std::nullopt
+                                                                   : std::optional(sourceLayer.toStdString());
+    const mbgl::FeatureState state = d_ptr->getFeatureState(sourceId.toStdString(), layer, featureId.toStdString());
+
+    QVariantMap result;
+    for (const auto &item : state) {
+        result.insert(QString::fromStdString(item.first), variantFromValue(item.second));
+    }
+    return result;
+}
+
+/*!
+    \brief Remove feature state.
+    \param sourceId The source identifier.
+    \param sourceLayer The source layer, empty for GeoJSON sources.
+    \param featureId The feature identifier; empty removes the state of every feature in the source (layer).
+    \param stateKey The key to remove; empty removes the whole state.
+
+    Returns \c false when no renderer exists yet.
+*/
+bool Map::removeFeatureState(const QString &sourceId,
+                             const QString &sourceLayer,
+                             const QString &featureId,
+                             const QString &stateKey) {
+    auto optional = [](const QString &value) -> std::optional<std::string> {
+        return value.isEmpty() ? std::nullopt : std::optional(value.toStdString());
+    };
+    d_ptr->removeFeatureState(sourceId.toStdString(), optional(sourceLayer), optional(featureId), optional(stateKey));
+    return d_ptr->hasRenderer();
+}
+
 /*!
     \brief Create the renderer.
     \param nativeTargetPtr The pointer to the native layer/window/surface.
@@ -2316,6 +2383,42 @@ std::vector<mbgl::Feature> MapPrivate::querySourceFeatures(const std::string &so
     return m_mapRenderer ? m_mapRenderer->querySourceFeatures(sourceId, options) : std::vector<mbgl::Feature>{};
 }
 
+void MapPrivate::setFeatureState(const std::string &sourceId,
+                                 const std::optional<std::string> &sourceLayer,
+                                 const std::string &featureId,
+                                 const mbgl::FeatureState &state) {
+    const std::scoped_lock lock(m_mapRendererMutex);
+    if (m_mapRenderer == nullptr) {
+        return;
+    }
+    m_mapRenderer->setFeatureState(sourceId, sourceLayer, featureId, state);
+    requestRendering();
+}
+
+mbgl::FeatureState MapPrivate::getFeatureState(const std::string &sourceId,
+                                               const std::optional<std::string> &sourceLayer,
+                                               const std::string &featureId) const {
+    const std::scoped_lock lock(m_mapRendererMutex);
+    return m_mapRenderer ? m_mapRenderer->getFeatureState(sourceId, sourceLayer, featureId) : mbgl::FeatureState{};
+}
+
+void MapPrivate::removeFeatureState(const std::string &sourceId,
+                                    const std::optional<std::string> &sourceLayer,
+                                    const std::optional<std::string> &featureId,
+                                    const std::optional<std::string> &stateKey) {
+    const std::scoped_lock lock(m_mapRendererMutex);
+    if (m_mapRenderer == nullptr) {
+        return;
+    }
+    m_mapRenderer->removeFeatureState(sourceId, sourceLayer, featureId, stateKey);
+    requestRendering();
+}
+
+bool MapPrivate::hasRenderer() const {
+    const std::scoped_lock lock(m_mapRendererMutex);
+    return m_mapRenderer != nullptr;
+}
+
 void *MapPrivate::currentDrawableTexture() const {
     const std::scoped_lock lock(m_mapRendererMutex);
     return m_mapRenderer ? m_mapRenderer->currentDrawableTexture() : nullptr;
