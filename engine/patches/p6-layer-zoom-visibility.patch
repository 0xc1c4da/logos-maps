+/*!
+    \brief Set the zoom range of a layer.
+    \param layerId The layer identifier.
+    \param minZoom The minimum zoom (inclusive) at which the layer is drawn.
+    \param maxZoom The maximum zoom (exclusive) at which the layer is drawn.
+    \return \c false when the layer does not exist.
+*/
+bool Map::setLayerZoomRange(const QString &layerId, double minZoom, double maxZoom) {
+    mbgl::style::Layer *layer = d_ptr->mapObj->getStyle().getLayer(layerId.toStdString());
+    if (layer == nullptr) {
+        qWarning() << "Layer not found:" << layerId;
+        return false;
+    }
+
+    layer->setMinZoom(static_cast<float>(minZoom));
+    layer->setMaxZoom(static_cast<float>(maxZoom));
+    return true;
+}
+
+/*!
+    \brief Show or hide a layer.
+    \param layerId The layer identifier.
+    \param visible Whether the layer is drawn.
+    \return \c false when the layer does not exist.
+
+    Equivalent to setting the \c visibility layout property, without going
+    through the property conversion.
+*/
+bool Map::setLayerVisibility(const QString &layerId, bool visible) {
+    mbgl::style::Layer *layer = d_ptr->mapObj->getStyle().getLayer(layerId.toStdString());
+    if (layer == nullptr) {
+        qWarning() << "Layer not found:" << layerId;
+        return false;
+    }
+
+    layer->setVisibility(visible ? mbgl::style::VisibilityType::Visible : mbgl::style::VisibilityType::None);
+    return true;
+}
+
+/*!
+    \brief Serialize a layer.
+    \param layerId The layer identifier.
+    \return The layer as style-spec JSON (UTF-8), or an empty array when the layer does not exist.
+
+    The result is the layer as the style currently holds it, including every
+    runtime change made through the property setters.
+*/
+QByteArray Map::getLayerJson(const QString &layerId) const {
+    const mbgl::style::Layer *layer = d_ptr->mapObj->getStyle().getLayer(layerId.toStdString());
+    if (layer == nullptr) {
+        return {};
+    }
+
+    rapidjson::StringBuffer buffer;
+    JSONWriter writer(buffer);
+    writeValue(writer, layer->serialize());
+    return QByteArray(buffer.GetString(), static_cast<qsizetype>(buffer.GetSize()));
+}
+
+/*!
+    \brief Describe a source.
+    \param sourceId The source identifier.
+    \return A JSON object (UTF-8) with the source's \c id, \c type, \c attribution
+    and \c volatile flag, or an empty array when the source does not exist.
+
+    Sources do not serialize their data; this returns what the style knows
+    about the source without it.
+*/
+QByteArray Map::getSourceJson(const QString &sourceId) const {
+    const mbgl::style::Source *source = d_ptr->mapObj->getStyle().getSource(sourceId.toStdString());
+    if (source == nullptr) {
+        return {};
+    }
+
+    std::unordered_map<std::string, mbgl::Value> object;
+    object.emplace("id", source->getID());
+    object.emplace("type", std::string(sourceTypeName(source->getType())));
+    if (const auto attribution = source->getAttribution()) {
+        object.emplace("attribution", *attribution);
+    }
+    object.emplace("volatile", source->isVolatile());
+
+    rapidjson::StringBuffer buffer;
+    JSONWriter writer(buffer);
+    writeValue(writer, mbgl::Value(std::move(object)));
+    return QByteArray(buffer.GetString(), static_cast<qsizetype>(buffer.GetSize()));
+}
