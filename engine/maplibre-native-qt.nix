# maplibre-native-qt — the Maps engine (docs/architecture.md §5, §14).
#
# Builds the MapLibre Native Qt binding (QMapLibre::Core, QMapLibre::Quick,
# the QML plugin) together with the MapLibre Native core it vendors, against
# the Qt the Logos SDK pins. The binding is pinned to a commit (§0.2 alias
# MLNQT) and carries the patch set in ./patches (§14.1): every patch is a
# small, upstreamable change to the *binding*; the core is never patched.
#
# Patches are capability-gated (§11.1). Each one applied defines a
# MAPS_ENGINE_HAS_<name> macro in the installed `QMapLibreConfigVersion`
# companion header `qmaplibre_patchset.h`, so maps_view reports exactly
# what the engine it links can do.
{ lib
, stdenv
, fetchFromGitHub
, cmake
, ninja
, pkg-config
, qt6
, icu
, zlib
, libglvnd
, mesa
, patches ? []
, withLocation ? false
, withWidgets ? false
, withPmtiles ? true
}:

let
  # docs/architecture.md §0.2: MLNQT c3485f3, vendoring maplibre-native 702ebc6.
  rev = "c3485f3a9590081c7be8edbc542341e688f6663d";

  patchNames = map (p: lib.removeSuffix ".patch" (baseNameOf (toString p))) patches;
  patchDefines = lib.concatMapStringsSep "\n"
    (n: "#define MAPS_ENGINE_HAS_${lib.toUpper (builtins.replaceStrings ["-"] ["_"] n)} 1")
    patchNames;
in
stdenv.mkDerivation {
  pname = "maplibre-native-qt";
  version = "unstable-${builtins.substring 0 7 rev}";

  src = fetchFromGitHub {
    owner = "maplibre";
    repo = "maplibre-native-qt";
    inherit rev;
    fetchSubmodules = true;
    # Filled in by `nix build` once (Spike B / M3): the fake hash makes nix
    # print the real one.
    hash = "sha256-nTVrGwGTtB1v6ka+h+63JHKyYOovcL6AmN+5Bm4Dyxg=";
  };

  inherit patches;

  nativeBuildInputs = [ cmake ninja pkg-config qt6.wrapQtAppsHook ];
  buildInputs = [
    qt6.qtbase
    qt6.qtdeclarative
    qt6.qtsvg
    icu
    zlib
    libglvnd
    mesa
  ] ++ lib.optionals withLocation [ qt6.qtlocation qt6.qtpositioning ];

  dontWrapQtApps = true;

  cmakeFlags = [
    "-DMLN_WITH_OPENGL=ON"
    "-DMLN_WITH_PMTILES=${if withPmtiles then "ON" else "OFF"}"
    "-DMLN_WITH_WERROR=OFF"
    "-DMLN_QT_WITH_QUICK_PLUGIN=ON"
    "-DMLN_QT_WITH_LOCATION=${if withLocation then "ON" else "OFF"}"
    "-DMLN_QT_WITH_WIDGETS=${if withWidgets then "ON" else "OFF"}"
    "-DMLN_QT_WITH_INTERNAL_ICU=OFF"
    "-DMLN_QT_WITH_INTERNAL_SQLITE=OFF"
    # P5: the storage ABI behind Settings::setFileSourceFactoryHook must be
    # linkable by maps_view (mbgl::FileSource implementations).
    "-DMLN_QT_WITH_EXPORTED_CORE=ON"
    "-DMLN_WITH_GLFW=OFF"
    "-DMLN_WITH_NODE=OFF"
    "-DCMAKE_BUILD_TYPE=Release"
  ];

  # The vendored core's CMake wants a git checkout for version stamping in a
  # few places; the fetched tree has none. Nothing we install depends on it.
  env.NIX_CFLAGS_COMPILE = "-Wno-error";

  postInstall = ''
    # Patch-set manifest for capability reporting (docs/architecture.md §11.1).
    mkdir -p $out/include/QMapLibre
    cat > $out/include/QMapLibre/qmaplibre_patchset.h <<EOF
    // Generated by engine/maplibre-native-qt.nix. One define per applied patch.
    #pragma once
    #define MAPS_ENGINE_BINDING_REV "${rev}"
    ${patchDefines}
    EOF
    # The Qt-private texture-node headers maps_view's MapItem builds on (§14.1 P7)
    # are installed by patch P7 itself; nothing to do here when it is absent.
  '';

  # Lets consumers (maps_view's flake, tests) see at eval time which patches
  # this build carries; the same list drives the header above.
  passthru = { inherit patchNames rev; };

  meta = with lib; {
    description = "MapLibre Native Qt binding with the Logos Maps patch set";
    homepage = "https://github.com/maplibre/maplibre-native-qt";
    license = licenses.bsd2;
    platforms = platforms.linux ++ platforms.darwin;
  };
}
