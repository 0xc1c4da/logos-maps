{
  "name": "maps_view",
  "display_name": "Maps",
  "version": "0.1.0",
  "type": "ui_qml",
  "interface": "universal",
  "category": "general",
  "description": "Maps: the map view. Renders the retained scene held by maps_core with MapLibre Native in its own process and presents it to the host through a view surface (docs/architecture.md section 3, section 5).",
  "author": "0xc1c4da",
  "main": "maps_view_plugin",
  "icon": "src/icons/icon.png",
  "view": "qml/Main.qml",
  "view_surface": true,
  "dependencies": ["maps_core"],
  "codegen": { "rep": "src/maps_view.rep" },

  "nix": {
    "packages": {
      "build": [],
      "runtime": ["qt6.qtdeclarative", "qt6.qtwayland"]
    },
    "external_libraries": [
      { "name": "QMapLibre" },
      { "name": "QMapLibreQuickPrivate" }
    ],
    "cmake": {
      "find_packages": [],
      "extra_sources": [],
      "extra_include_dirs": [],
      "extra_link_libraries": []
    }
  }
}
