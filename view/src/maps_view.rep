// View <-> backend contract for the Maps view (docs/architecture.md section 12.2).
//
// Exposed only to the host embedding the surface. The host never drives
// scene content through this replica -- that goes through maps_core so every
// module sees it. Keep slots to <= 4 arguments; structured data is one JSON
// string.
class MapsView
{
    PROP(QString viewId READONLY)             // "<module>/<session>/<n>", set once the view opened in maps_core
    PROP(QString surfaceToken READONLY)       // RFC-2 handle for Logos.Surface ("" when surface.transport is none)
    PROP(QString viewStateJson READONLY)      // camera, basemap, size, dpr, gestureState (throttled per frame)
    PROP(QString capabilitiesJson READONLY)   // M11.1 report for this view
    PROP(QString status="starting" READONLY)  // starting | opening | ready | error: <text>

    SLOT(void setSize(int w, int h, double dpr))   // from the Surface item (RFC-5 rule 2); informative under Wayland
    SLOT(void setOptions(QString json))            // same schema as maps_core.setViewOptions
    SLOT(void camera(QString intentJson))          // same schema as maps_core.camera
    SLOT(void setSession(QString session))         // RFC-3: host-chosen session, becomes the viewId prefix

    SIGNAL(featurePicked(QString json))
    SIGNAL(cameraIdle(QString json))
    SIGNAL(attributionChanged(QString html))
}
